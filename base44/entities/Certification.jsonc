{
  "name": "Certification",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Expired",
        "In Progress",
        "Completed"
      ],
      "default": "Active"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "credential_id": {
      "type": "string"
    },
    "include_in_outputs": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}