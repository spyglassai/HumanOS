{
  "name": "PublicProfile",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "visible": {
            "type": "boolean",
            "default": false
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Private",
        "Public",
        "Unlisted",
        "Share with Link"
      ],
      "default": "Private"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}