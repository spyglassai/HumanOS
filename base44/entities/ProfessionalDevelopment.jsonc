{
  "name": "ProfessionalDevelopment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Course",
        "Certification",
        "Workshop",
        "Conference",
        "Self-study",
        "Other"
      ],
      "default": "Course"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}