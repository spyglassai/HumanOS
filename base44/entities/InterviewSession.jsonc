{
  "name": "InterviewSession",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "Orientation",
        "Career Timeline",
        "Deep Role",
        "Project Discovery",
        "Leadership",
        "Failure & Learning",
        "Professional Philosophy",
        "Future Self"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "in_progress"
    },
    "current_question": {
      "type": "string"
    },
    "questions_asked": {
      "type": "number",
      "default": 0
    },
    "areas_explored": {
      "type": "number",
      "default": 0
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "phase"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}