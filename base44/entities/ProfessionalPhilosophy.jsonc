{
  "name": "ProfessionalPhilosophy",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Leadership",
        "Technology",
        "AI",
        "Customer",
        "Learning",
        "Innovation",
        "Organizational",
        "Management"
      ]
    },
    "content": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "PUBLIC",
        "UNLISTED"
      ],
      "default": "PRIVATE"
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}