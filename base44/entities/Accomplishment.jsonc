{
  "name": "Accomplishment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "problem": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "business_impact": {
      "type": "string"
    },
    "technical_impact": {
      "type": "string"
    },
    "people_impact": {
      "type": "string"
    },
    "scale": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_demonstrated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leadership_demonstrated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strategic_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_wording": {
      "type": "string"
    },
    "locked_wording": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "USER_CONFIRMED",
        "DOCUMENT_SUPPORTED",
        "AI_INFERRED",
        "UNVERIFIED"
      ],
      "default": "USER_CONFIRMED"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}